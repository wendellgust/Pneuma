{
  "name": "pneuma",
  "displayName": "Pneuma",
  "description": "Build, upload and monitor microcontrollers (Arduino AVR, ESP32, RP2040) with the Pneuma CLI.",
  "version": "0.1.1",
  "publisher": "pneuma-dev",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0b1020",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "arduino",
    "esp32",
    "rp2040",
    "microcontroller",
    "platformio"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/pneuma.lua",
    "workspaceContains:**/bmu.lua",
    "workspaceContains:**/platformio.ini",
    "onCommand:pneuma.new",
    "onView:pneuma.welcome",
    "onView:pneuma.tasks",
    "onView:pneuma.ports",
    "onView:pneuma.libs"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pneuma.build",
        "title": "Pneuma: Build",
        "icon": "$(check)"
      },
      {
        "command": "pneuma.upload",
        "title": "Pneuma: Upload",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "pneuma.run",
        "title": "Pneuma: Build, Upload and Monitor",
        "icon": "$(play)"
      },
      {
        "command": "pneuma.monitor",
        "title": "Pneuma: Serial Monitor",
        "icon": "$(plug)"
      },
      {
        "command": "pneuma.selectEnv",
        "title": "Pneuma: Select Environment"
      },
      {
        "command": "pneuma.selectPort",
        "title": "Pneuma: Select Port"
      },
      {
        "command": "pneuma.new",
        "title": "Pneuma: New Project"
      },
      {
        "command": "pneuma.addLibrary",
        "title": "Pneuma: Add Library",
        "icon": "$(add)"
      },
      {
        "command": "pneuma.searchLibrary",
        "title": "Pneuma: Search Libraries",
        "icon": "$(search)"
      },
      {
        "command": "pneuma.setup",
        "title": "Pneuma: Install Toolchain (AVR)"
      },
      {
        "command": "pneuma.openTui",
        "title": "Pneuma: Open Terminal UI"
      },
      {
        "command": "pneuma.refresh",
        "title": "Pneuma: Refresh Project Info",
        "icon": "$(refresh)"
      },
      {
        "command": "pneuma.revealLib",
        "title": "Pneuma: Reveal Library"
      }
    ],
    "keybindings": [
      {
        "command": "pneuma.build",
        "key": "ctrl+alt+b",
        "when": "pneuma.active"
      },
      {
        "command": "pneuma.upload",
        "key": "ctrl+alt+u",
        "when": "pneuma.active"
      },
      {
        "command": "pneuma.monitor",
        "key": "ctrl+alt+m",
        "when": "pneuma.active"
      }
    ],
    "configuration": {
      "title": "Pneuma",
      "properties": {
        "pneuma.path": {
          "type": "string",
          "default": "",
          "description": "Path to the pneuma binary or the pneuma.sh launcher. Empty: look in PATH, then ~/.cargo/bin."
        },
        "pneuma.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the Pneuma buttons in the status bar."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "pneuma",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "upload",
              "run",
              "monitor"
            ],
            "description": "pneuma sub-command"
          },
          "env": {
            "type": "string",
            "description": "Environment (-e). Default: the one selected in the status bar."
          },
          "port": {
            "type": "string",
            "description": "Serial port (-p). Default: auto."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "pneuma-gcc",
        "owner": "pneuma",
        "fileLocation": [
          "absolute"
        ],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(?:fatal )?(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pneuma",
          "title": "Pneuma",
          "icon": "media/pneuma.svg"
        }
      ]
    },
    "views": {
      "pneuma": [
        {
          "id": "pneuma.tasks",
          "name": "Project Tasks",
          "when": "pneuma.active"
        },
        {
          "id": "pneuma.ports",
          "name": "Ports",
          "when": "pneuma.active"
        },
        {
          "id": "pneuma.libs",
          "name": "Libraries",
          "when": "pneuma.active"
        },
        {
          "id": "pneuma.welcome",
          "name": "Pneuma",
          "when": "!pneuma.active"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pneuma.welcome",
        "when": "pneuma.noBinary",
        "contents": "The pneuma program was not found.\nBuild it with `./pneuma.sh install` (puts it in ~/.cargo/bin), or point the extension at it:\n[Open Pneuma Settings](command:workbench.action.openSettings?%5B%22pneuma.path%22%5D)\n[Try Again](command:pneuma.refresh)"
      },
      {
        "view": "pneuma.welcome",
        "when": "!pneuma.noBinary",
        "contents": "No Pneuma project in this folder (needs a pneuma.lua).\n[New Project](command:pneuma.new)\nOr run `pneuma init` inside an existing project, then:\n[Refresh](command:pneuma.refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pneuma.refresh",
          "when": "view == pneuma.tasks || view == pneuma.ports",
          "group": "navigation"
        },
        {
          "command": "pneuma.addLibrary",
          "when": "view == pneuma.libs",
          "group": "navigation@1"
        },
        {
          "command": "pneuma.searchLibrary",
          "when": "view == pneuma.libs",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pneuma.revealLib",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/",
    "package": "npx --yes @vscode/vsce package"
  }
}
